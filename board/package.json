{
	"name": "lat-board",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"board": "bun src/cli.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"build:test": "LAT_BOARD_BUILD_DIR=build-test vite build",
		"test": "bun test",
		"test:server": "bun run build:test && bun test --timeout 30000 ./tests/server",
		"test:browser": "bun run build:test && bun test --timeout 30000 ./tests/browser",
		"test:all": "bun run build:test && bun test --timeout 30000 ./tests",
		"demo": "bun scripts/demo-board.ts",
		"repro:hydration": "bun scripts/hydration-repro.ts",
		"measure:commandline": "bun scripts/measure-commandline.ts"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.57.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.4.3",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^22",
		"markdown-it": "^15.0.2",
		"markdown-it-cjk-friendly": "3.0.0",
		"opencc-js": "^1.4.2",
		"smol-toml": "^1.9.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	}
}
