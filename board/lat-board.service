# LAT 看板的 systemd 使用者服務範例。用法見 docs/lat-board.md。
# 複製到 ~/.config/systemd/user/lat-board.service，把 <...> 換成你的實際值。
[Unit]
Description=LAT 看板
After=network-online.target
Wants=network-online.target

[Service]
# 專案裡的 board 目錄（已執行過 install 與 build）
WorkingDirectory=<專案目錄>/board
# 服務的 PATH 很短，須含 node、uv、hcom、herdr、git 所在的目錄（用 command -v 查）；只有 Bun 的主機把 node 換成 bun
Environment=PATH=<node 所在目錄>:<uv、hcom 與 herdr 所在目錄>:/usr/local/bin:/usr/bin:/bin
# 新建主控要連到 Herdr；它的 socket 不在預設位置時設定：
# Environment=HERDR_SOCKET_PATH=<socket 路徑>
# 監聽位址與連接埠；想只給本機用就改成 127.0.0.1
Environment=HOST=0.0.0.0
Environment=PORT=7100
# 預設只接受本機連線。放在反向代理後面時，把代理加進允許來源與信任代理（見 docs/lat-board.md「連線來源與反向代理」）：
# Environment=LAT_BOARD_ALLOWED_SOURCES=127.0.0.1,::1,<代理位址>
# Environment=LAT_BOARD_TRUSTED_PROXIES=<代理位址>
# 其他設定（見 board/README.md）需要時再加，例如：
# Environment=LAT_BOARD_STATE_DIR=<目錄>
# 只有 Bun 的主機改成：ExecStart=/usr/bin/env bun build/index.js
ExecStart=/usr/bin/env node build
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
