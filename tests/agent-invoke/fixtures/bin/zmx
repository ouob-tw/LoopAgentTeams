#!/usr/bin/env bash
set -euo pipefail

dir=${FAKE_ZMX_DIR:?}
command=${1:?}; handle=${2:?}
case $command in
  start) : > "$dir/$handle" ;;
  exists) [[ -f "$dir/$handle" ]] ;;
  stop) mv -- "$dir/$handle" "$dir/stopped-$handle" ;;
  send)
    cat >> "$dir/$handle.messages"
    ;;
  enter) printf '\r' >> "$dir/$handle.messages" ;;
  *) exit 64 ;;
esac
