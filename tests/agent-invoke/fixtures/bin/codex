#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "codex|$PWD|$*" >> "$FAKE_LOG"
if [[ -n ${FAKE_SYNC_READY:-} ]]; then
  : > "$FAKE_SYNC_READY"
  while [[ ! -e ${FAKE_SYNC_RELEASE:?} ]]; do sleep 0.02; done
fi
cat > "$FAKE_STDIN"
case ${FAKE_CODEX_MODE:-ok} in
  dependency|auth|quota|permission) exit 42 ;;
  mismatch) printf '{"type":"thread.started","thread_id":"wrong-thread"}\n' ;;
  duplicate) printf '{"type":"thread.started","thread_id":"%s"}\n{"type":"thread.started","thread_id":"%s"}\n' "$FAKE_SESSION" "$FAKE_SESSION" ;;
  no-seal) exit 43 ;;
  *)
    if [[ -n ${FAKE_CODEX_TRANSCRIPT:-} ]]; then
      mkdir -p "$(dirname "$FAKE_CODEX_TRANSCRIPT")"
      printf '{"type":"session_meta","payload":{"id":"%s","cwd":"%s"}}\n' "$FAKE_SESSION" "$PWD" >> "$FAKE_CODEX_TRANSCRIPT"
    fi
    printf '{"type":"thread.started","thread_id":"%s"}\n{"type":"response.completed"}\n' "$FAKE_SESSION"
    sleep "${FAKE_DELAY:-1}"
    ;;
esac
